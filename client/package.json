    "test": "vitest run --config ../vitest.config.ts --project client"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "@dogfight/shared": "*"
  }
}
