HOST=127.0.0.1
PORT=3000
LOG_DIR=logs
MAX_ROOMS=100
MAX_PLAYERS_PER_ROOM=16
MAX_PAYLOAD=16384
MAX_MESSAGES_PER_SECOND=60
SLOW_CLIENT_BYTES=524288
# Injected network conditions, one-way per direction (each connection can override)
NET_LAG_MS=0
NET_JITTER_MS=0
NET_DROP=0
# --- production (lab 8) ---
LOG_LEVEL=info
# Extra origins allowed to open /ws (comma-separated); the same host is always allowed
ALLOWED_ORIGINS=
MAX_CONNECTIONS=1000
MAX_CONNECTIONS_PER_IP=8
# true only behind a reverse proxy that sets X-Forwarded-For (Fly, Render, nginx)
TRUST_PROXY=false
SHUTDOWN_TIMEOUT_MS=8000
ROOM_IDLE_MS=60000
# If set, /metrics needs "Authorization: Bearer <token>" (keep it in the platform's secret store)
METRICS_TOKEN=
